# =============================================================================
# Itzam.ai env vars — copy to .env.local and fill in real values.
# Never commit .env.local.
# =============================================================================

# --- Landing waitlist (existing) ---------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Subdomain & deployment --------------------------------------------------
APP_BASE_URL=https://app.itzam.ai
# Optional: set to "1" to force the app subdomain rewrite when running on
# localhost — useful for testing /app routes without DNS.
FORCE_APP_HOST=0

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin allowlist (bootstrap fallback only — main source is admins table) -
ADMIN_EMAILS=

# --- Resend ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
INTERNAL_NOTIFY_EMAIL=

# --- Drive Apps Script v2 (intake) ------------------------------------------
DRIVE_WEBHOOK_URL=
DRIVE_WEBHOOK_SECRET=

# --- Cron --------------------------------------------------------------------
CRON_SECRET=

# --- Cloudflare Turnstile (bot challenge on /login + /signup) ---------------
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Hostnames must include app.itzam.ai (and localhost for local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Free AI Assessment (self-serve lead magnet) ----------------------------
# Google Sheets Apps Script Web App that receives /assessment submissions.
# Deploy apps-script/assessment-webhook.gs (see docs/self-assessment.md).
GOOGLE_SHEETS_ASSESSMENT_WEBHOOK_URL=
# Optional shared secret. If set, it must match the Apps Script's WEBHOOK_SECRET
# script property. Leave blank on both sides to skip the check.
GOOGLE_SHEETS_ASSESSMENT_SECRET=

# --- HubSpot ----------------------------------------------------------------
# Private App access token. Create one at:
#   HubSpot → Settings → Integrations → Private Apps → Create a private app
# Required scopes:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read, crm.objects.deals.write
# Leave blank to disable CRM sync (safe no-op).
HUBSPOT_ACCESS_TOKEN=

# Portal ID (numeric, ~7 digits). Find it at HubSpot → Settings → Account
# Defaults → top-right Account ID. Used only by the public tracking script.
# Leave blank to disable the in-browser tracker.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
