# =============================================================================
# Itzam.ai env vars — copy to .env.local and fill in real values.
# Never commit .env.local.
# =============================================================================

# --- Landing waitlist (existing) ---------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Subdomain & deployment --------------------------------------------------
APP_BASE_URL=https://app.itzam.ai
# Optional: set to "1" to force the app subdomain rewrite when running on
# localhost — useful for testing /app routes without DNS.
FORCE_APP_HOST=0

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin allowlist (bootstrap fallback only — main source is admins table) -
ADMIN_EMAILS=

# --- Resend ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Itzam.ai <hello@notifications.itzam.ai>
INTERNAL_NOTIFY_EMAIL=

# --- Drive Apps Script v2 (intake) ------------------------------------------
DRIVE_WEBHOOK_URL=
DRIVE_WEBHOOK_SECRET=

# --- Cron --------------------------------------------------------------------
CRON_SECRET=
